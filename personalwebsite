}
 
.card-bg-1 { background: linear-gradient(135deg, var(--sage) 0%, var(--sage-light) 100%); }
.card-bg-2 { background: linear-gradient(135deg, var(--terracotta) 0%, var(--terracotta-soft) 100%); }
.card-bg-3 { background: linear-gradient(135deg, var(--clay-dark) 0%, var(--clay) 100%); }
 
.perspective-category {
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
