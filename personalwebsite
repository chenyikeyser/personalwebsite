}
 
/* --- BY THE NUMBERS --- */
.numbers-section {
  background: var(--ink);
  padding: 6rem 5rem;
  position: relative;
  overflow: hidden;
}
 
.numbers-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 70% 30%, rgba(184, 101, 74, 0.15) 0%, transparent 60%);
}
 
.numbers-grid {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3rem;
}
 
.number-card {
  text-align: center;
  position: relative;
}
 
.number-card::after {
  content: '';
  position: absolute;
  right: 0;
  top: 10%;
  height: 80%;
  width: 1px;
  background: rgba(196, 168, 130, 0.2);
}
 
.number-card:last-child::after { display: none; }
 
.number-value {
  font-family: 'Playfair Display', serif;
  font-size: 3.5rem;
  font-weight: 900;
  color: var(--clay);
  line-height: 1;
  margin-bottom: 0.5rem;
}
 
.number-label {
  font-size: 0.75rem;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--clay-light);
  line-height: 1.5;
}
 
/* --- PERSPECTIVES / BLOG --- */
.perspectives-section {
  position: relative;
}
 
.perspectives-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(to right, transparent, var(--clay-light), transparent);
}
 
.perspectives-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
  margin-top: 3rem;
}
 
.perspective-card {
  cursor: pointer;
  transition: transform 0.4s;
}
 
.perspective-card:hover { transform: translateY(-4px); }
 
.perspective-card-img {
